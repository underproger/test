          <div class="swiper-wrapper">
            {% for banner in banner_images[1] %}
              <div class="swiper-slide banner-slide" style="height: fit-content;">
                <div class="banner-image">
                  <div class="banner-image__wrapper">
                    <img src="{{ banner.image }}" alt="{{ banner.title }}" />
                  </div>
                </div>
                <div class="banner__info">
                  {% if banner.label %}
                    <div class="banner__label">{{ banner.label }}</div>
                  {% endif %}
                  {% if banner.title %}
                    <div class="banner__title">{{ banner.title }}</div>
                  {% endif %}
                  {% if banner.text %}
                    <div class="banner__text">{{ banner.text }}</div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="swiper-pagination"></div>
        </div>
      </div>
    </div>
