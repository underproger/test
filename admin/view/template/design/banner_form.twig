{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a class="btn btn-default" href="{{preview_url}}" target="_blank"><i class="fa fa-eye"></i></a>
        <button type="submit" form="form-banner" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-banner" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
              {% if error_name %}
              <div class="text-danger">{{ error_name }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <br />
          <ul class="nav nav-tabs" id="language">
            {% for language in languages %}
            <li><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
            {% endfor %}
          </ul>
          <div class="tab-content">
            {% set image_row = 0 %}
            {% for language in languages %}
            <div class="tab-pane" id="language{{ language.language_id }}">
              <table id="images{{ language.language_id }}" class="table table-striped table-bordered table-hover">
                <thead>
                  <tr>
                    <td class="text-left">Лейбл / Заголовок / Текст / Посилання</td>
                    <td class="text-center">{{ entry_image }}</td>
                    <td class="text-left">Товари</td>
                    <td class="text-center">На всю ширину</td>
                    <td class="text-left">Дата початку / Дата кінця</td>
                    <td class="text-right">{{ entry_sort_order }}</td>
                    <td></td>
                  </tr>
                </thead>
                <tbody>
                  {% if banner_images[language.language_id] %}
                  {% for banner_image in banner_images[language.language_id] %}
                  <tr id="image-row{{ image_row }}">

                    <!-- Лейбл / Заголовок / Текст / Посилання -->
                    <td class="text-left">
                      <input type="text" name="banner_image[{{ language.language_id }}][{{ image_row }}][label]" value="{{ banner_image.label }}" placeholder="Лейбл" class="form-control" style="margin-bottom:4px;" />
                      <input type="text" name="banner_image[{{ language.language_id }}][{{ image_row }}][title]" value="{{ banner_image.title }}" placeholder="{{ entry_title }}" class="form-control" style="margin-bottom:4px;" />
                      {% if error_banner_image[language.language_id][image_row] %}
                      <div class="text-danger">{{ error_banner_image[language.language_id][image_row] }}</div>
                      {% endif %}
                      <input type="text" name="banner_image[{{ language.language_id }}][{{ image_row }}][text]" value="{{ banner_image.text }}" placeholder="Текст" class="form-control" style="margin-bottom:4px;" />
                      <input type="text" name="banner_image[{{ language.language_id }}][{{ image_row }}][button]" value="{{ banner_image.button }}" placeholder="Текст кнопки" class="form-control" />
                      <input type="text" name="banner_image[{{ language.language_id }}][{{ image_row }}][link]" value="{{ banner_image.link }}" placeholder="{{ entry_link }}" class="form-control" />
                    </td>

                    <!-- Зображення -->
                    <td class="text-center">
                      <a href="" id="thumb-image{{ image_row }}" data-toggle="image" class="img-thumbnail">
                        <img src="{{ banner_image.thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" />
                      </a>
                      <input type="hidden" name="banner_image[{{ language.language_id }}][{{ image_row }}][image]" value="{{ banner_image.image }}" id="input-image{{ image_row }}" />
                    </td>

                    <!-- Товари (autocomplete) -->
                    <td class="text-left" style="width: 20%;">
                      <input type="text" name="banner_image[{{ language.language_id }}][{{ image_row }}][product_input]" value="" placeholder="Пошук товару..." class="form-control banner-product-input" data-row="{{ image_row }}" style="margin-bottom:4px;" />
                      <div id="banner-products{{ image_row }}" class="well well-sm" style="min-height: 60px; max-height: 150px; overflow: auto;">
                        {% if banner_image.products %}
                        {% for product in banner_image.products %}
                        <div id="banner-product{{ image_row }}-{{ product.product_id }}">
                          <i class="fa fa-minus-circle" style="cursor:pointer;"></i> {{ product.name }}
                          <input type="hidden" name="banner_image[{{ language.language_id }}][{{ image_row }}][products][]" value="{{ product.product_id }}" />
                        </div>
                        {% endfor %}
                        {% endif %}
                      </div>
                    </td>

                    <!-- На всю ширину -->
                    <td class="text-center">
                      <input type="checkbox" name="banner_image[{{ language.language_id }}][{{ image_row }}][is_full]" value="1" class="form-control" {% if banner_image.is_full %} checked {% endif %}/>
                    </td>

                    <!-- Дата початку / Дата кінця -->
                    <td class="text-left" style="width: 15%;">
                      <div class="input-group date" style="margin-bottom:4px;">
                        <input type="text" name="banner_image[{{ language.language_id }}][{{ image_row }}][date_start]" value="{{ banner_image.date_start }}" placeholder="Дата початку" data-date-format="YYYY-MM-DD" id="input-date-start{{ image_row }}" class="form-control"/>
                        <span class="input-group-btn">
                          <button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
                        </span>
                      </div>
                      <div class="input-group date">
                        <input type="text" name="banner_image[{{ language.language_id }}][{{ image_row }}][date_end]" value="{{ banner_image.date_end }}" placeholder="Дата кінця" data-date-format="YYYY-MM-DD" id="input-date-end{{ image_row }}" class="form-control"/>
                        <span class="input-group-btn">
                          <button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
                        </span>
                      </div>
                    </td>

                    <!-- Сортування -->
                    <td class="text-right" style="width: 8%;">
                      <input type="text" name="banner_image[{{ language.language_id }}][{{ image_row }}][sort_order]" value="{{ banner_image.sort_order }}" placeholder="{{ entry_sort_order }}" class="form-control" />
                    </td>

                    <!-- Видалити рядок -->
                    <td class="text-left">
                      <button type="button" onclick="$('#image-row{{ image_row }}, .tooltip').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
                    </td>
                  </tr>
                  {% set image_row = image_row + 1 %}
                  {% endfor %}
                  {% endif %}
                </tbody>
                <tfoot>
                  <tr>
                    <td colspan="6"></td>
                    <td class="text-left">
                      <button type="button" onclick="addImage('{{ language.language_id }}');" data-toggle="tooltip" title="{{ button_banner_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
            {% endfor %}
          </div>
        </form>
      </div>
    </div>
  </div>

  <script type="text/javascript"><!--

  var image_row = {{ image_row }};

  for ( let i = 0; i < image_row; i++ ) {
  // Reorderable drag-and-drop lists
      console.log('#banner-products' + i + ' div input');
      console.log($('#banner-products' + i + ' div input'));
      $('#banner-products' + i + ' div input').before(' <i class="fa fa-hand-grab-o handle"></i> ');
      $('#banner-products' + i + '').sortable({
        handle: '.handle',
        chosenClass: 'handle-active',
      });
  }

function addImage(language_id) {
  var html  = '<tr id="image-row' + image_row + '">';

  // Лейбл / Заголовок / Текст / Посилання
  html += '<td class="text-left">';
  html += '  <input type="text" name="banner_image[' + language_id + '][' + image_row + '][label]" value="" placeholder="Лейбл" class="form-control" style="margin-bottom:4px;" />';
  html += '  <input type="text" name="banner_image[' + language_id + '][' + image_row + '][title]" value="" placeholder="{{ entry_title }}" class="form-control" style="margin-bottom:4px;" />';
  html += '  <input type="text" name="banner_image[' + language_id + '][' + image_row + '][text]" value="" placeholder="Текст" class="form-control" style="margin-bottom:4px;" />';
  html += '  <input type="text" name="banner_image[' + language_id + '][' + image_row + '][button]" value="" placeholder="Текст кнопки" class="form-control" style="margin-bottom:4px;" />';
  html += '  <input type="text" name="banner_image[' + language_id + '][' + image_row + '][link]" value="" placeholder="{{ entry_link }}" class="form-control" />';
  html += '</td>';

  // Зображення
  html += '<td class="text-center">';
  html += '  <a href="" id="thumb-image' + image_row + '" data-toggle="image" class="img-thumbnail"><img src="{{ placeholder }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>';
  html += '  <input type="hidden" name="banner_image[' + language_id + '][' + image_row + '][image]" value="" id="input-image' + image_row + '" />';
  html += '</td>';

  // Товари
  html += '<td class="text-left" style="width:20%;">';
  html += '  <input type="text" name="banner_image[' + language_id + '][' + image_row + '][product_input]" value="" placeholder="Пошук товару..." class="form-control banner-product-input" data-row="' + image_row + '" style="margin-bottom:4px;" />';
  html += '  <div id="banner-products' + image_row + '" class="well well-sm" style="min-height:60px; max-height:150px; overflow:auto;"></div>';
  html += '</td>';

  // На всю ширину
  html += '<td class="text-center"><input type="checkbox" name="banner_image[' + language_id + '][' + image_row + '][is_full]" value="1" class="form-control" /></td>';

  // Дата початку / Дата кінця
  html += '<td class="text-left" style="width:15%;">';
  html += '  <div class="input-group date" style="margin-bottom:4px;"><input type="text" name="banner_image[' + language_id + '][' + image_row + '][date_start]" value="" placeholder="Дата початку" class="form-control" /><span class="input-group-btn"><button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button></span></div>';
  html += '  <div class="input-group date"><input type="text" name="banner_image[' + language_id + '][' + image_row + '][date_end]" value="" placeholder="Дата кінця" class="form-control" /><span class="input-group-btn"><button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button></span></div>';
  html += '</td>';

  // Сортування
  html += '<td class="text-right" style="width:8%;"><input type="text" name="banner_image[' + language_id + '][' + image_row + '][sort_order]" value="" placeholder="{{ entry_sort_order }}" class="form-control" /></td>';

  // Видалити
  html += '<td class="text-left"><button type="button" onclick="$(\'#image-row' + image_row + ', .tooltip\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';

  html += '</tr>';

  $('#images' + language_id + ' tbody').append(html);

  // Ініціалізація autocomplete для нового рядка
  initProductAutocomplete(image_row, language_id);

  image_row++;
}

function initProductAutocomplete(row, language_id) {
  $('input.banner-product-input[data-row="' + row + '"]').autocomplete({
    'source': function(request, response) {
      $.ajax({
        url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_model=' + encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
          response($.map(json, function(item) {
            return {
              label: item['name'],
              value: item['product_id']
            }
          }));
        }
      });
    },
    'select': function(item) {
      // Очищаємо поле вводу
      $('input.banner-product-input[data-row="' + row + '"]').val('');

      // Не додаємо дублікати
      if ($('#banner-products' + row + ' #banner-product' + row + '-' + item['value']).length) {
        return;
      }

      $('#banner-products' + row).append(
        '<div id="banner-product' + row + '-' + item['value'] + '">' +
        '<i class="fa fa-minus-circle" style="cursor:pointer;"></i> ' + item['label'] +
        '<input type="hidden" name="banner_image[' + language_id + '][' + row + '][products][]" value="' + item['value'] + '" />' +
        '</div>'
      );
    }
  });
}

// Делегований обробник видалення товару
$(document).on('click', '[id^="banner-products"] .fa-minus-circle', function() {
  $(this).parent().remove();
});

// Ініціалізація autocomplete для вже існуючих рядків
{% for language in languages %}
{% if banner_images[language.language_id] %}
{% set init_row = 0 %}
{% for banner_image in banner_images[language.language_id] %}
initProductAutocomplete({{ init_row }}, {{ language.language_id }});
{% set init_row = init_row + 1 %}
{% endfor %}
{% endif %}
{% endfor %}

//--></script>

  <script type="text/javascript"><!--
$('#language a:first').tab('show');

$('.date').datetimepicker({
  language: '{{ datepicker }}',
  pickTime: false
});

$('.time').datetimepicker({
  language: '{{ datepicker }}',
  pickDate: false
});

$('.datetime').datetimepicker({
  language: '{{ datepicker }}',
  pickDate: true,
  pickTime: true
});
//--></script>
</div>
{{ footer }}