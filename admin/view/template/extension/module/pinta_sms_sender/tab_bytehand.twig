<table class="table">
    <tr>
        <td class="col-xs-3">
            <h5><strong>{{ text_info }}</strong></h5>
        </td>
        <td class="col-xs-9">
            <div class="col-xs-5">
                <div class="form-group">
                    <span class="help"><i class="fa fa-info-circle"></i>&nbsp;{{ bytehand_help_api }}</span>
                </div>
            </div>
        </td>
    </tr>
    <tr>
        <td class="col-xs-3">
            <h5><strong>{{ bytehand_api_key }}</strong></h5>
        </td>
        <td class="col-xs-9">
            <div class="col-xs-5">
                <div class="form-group">
                    <div class="form-group">
                        <input type="text" class="form-control" name="PintaSmsSender[Bytehand][APIKey]" value="{{ data.PintaSmsSender.Bytehand.APIKey ? data.PintaSmsSender.Bytehand.APIKey : "" }}" />
                    </div>
                </div>
            </div>
        </td>
    </tr>
    <tr>
        <td class="col-xs-3">
            <h5><strong>{{ bytehand_sender }}</strong></h5>
            <span class="help"><i class="fa fa-info-circle"></i>&nbsp;{{ bytehand_help_sender }}</span>
        </td>
        <td class="col-xs-9">
            <div class="col-xs-5">
                <div class="form-group" name="phone_input">
                    <input type="text" class="form-control" name="PintaSmsSender[Bytehand][Sender]" maxlength="15" value="{{ data.PintaSmsSender.Bytehand.Sender ? data.PintaSmsSender.Bytehand.Sender : "" }}" />
                </div>
            </div>
        </td>
    </tr>
</table>