<script>
    let maxSmsChars = {{ sms_size }};

    function countCharactersAndSMS(selector, charCounter, smsCounter) {
        let count = [];
        let sms = 1;

        $('[id="' + selector + '"]').each(function (i) {
            count[i] = $(this).val().length;
            window.messageLength = count[i];

            $(this).keyup(function () {
                let tabOrder = $(this).closest('.active');
                window.messageLength = $(this).val().length;

                tabOrder.find('#' + charCounter + '').html($(this).val().length);
                bytes_count = getByteLen($(this).val());
                if (bytes_count > 0 && bytes_count < maxSmsChars) {
                    tabOrder.find('#' + smsCounter + '').html(1);
                } else if (bytes_count >= maxSmsChars) {
                    tabOrder.find('#' + smsCounter + '').html(Math.floor(bytes_count / maxSmsChars) + 1);
                } else {
                    tabOrder.find('#' + smsCounter + '').html(0);
                }
            });
        });

        $('[id="' + charCounter + '"]').each(function (i) {
            $(this).html(count[i]);
        });

        $('[id="' + smsCounter + '"]').each(function () {
            $(this).html(sms);
        });

    }

    function getByteLen(normal_val) {
        // Force string type
        normal_val = String(normal_val);
        let byteLen = 0;
        for (let i = 0; i < normal_val.length; i++) {
            let c = normal_val.charCodeAt(i);
            byteLen += c < (1 << 7) ? 1 :
                c < (1 << 11) ? 2 :
                    c < (1 << 16) ? 3 :
                        c < (1 << 21) ? 4 :
                            c < (1 << 26) ? 5 :
                                c < (1 << 31) ? 6 : Number.NaN;
        }
        return byteLen;
    }

    function changeOrderStatuses(event, checked) {
        event.preventDefault();
        event.stopPropagation();

        $('.orderStatuses.checkbox input').each(function () {
            this.checked = checked;
        });
    }

    $(function () {
        $('a[href="#customerOrder"]').tab('show');

        countCharactersAndSMS('text-customer-place-quick-order', 'text-customer-place-quick-order-characters', 'text-customer-place-quick-order-sms');
        countCharactersAndSMS('text-customer-place-order', 'text-customer-place-order-characters', 'text-customer-place-order-sms');
        countCharactersAndSMS('text-customer-order-status-change', 'text-customer-order-status-change-characters', 'text-customer-order-status-change-sms');
        countCharactersAndSMS('text-customer-register', 'text-customer-register-characters', 'text-customer-register-sms');
        countCharactersAndSMS('text-admin-quick-order-placed', 'text-admin-quick-order-placed-characters', 'text-admin-quick-order-placed-sms');
        countCharactersAndSMS('text-admin-order-placed', 'text-admin-order-placed-characters', 'text-admin-order-placed-sms');
        countCharactersAndSMS('text-admin-on-register', 'text-admin-on-register-characters', 'text-admin-on-register-sms');

        $('#selectall').click(function (event) {
            changeOrderStatuses(event, true);
        });

        $('#deselectall').click(function (event) {
            changeOrderStatuses(event, false)
        });
    });
</script>
