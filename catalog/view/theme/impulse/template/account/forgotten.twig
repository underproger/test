{{ header }}
<nav class="breadcrumbs" aria-label="breadcrumb">
  <div class="_container">
    <ol class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item">
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        </li>
      {% endfor %}
    </ol>
  </div>
</nav>

<section id="account-forgotten" class="account">
  <div class="_container">
    <div class="account__wrapper">
      <h1 class="account__title h2 section-title">{{ heading_title }}</h1>
      {% if error_warning %}
        <div class="alert alert-danger alert-dismissible">
          <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        </div>
      {% endif %}
      <div class="account-main">
        <div class="account-list">
          <div class="row">
            <div id="content" class="{{ class }}">
              {{ content_top }}
              <h1>{{ heading_title }}</h1>
              <p>{{ text_email }}</p>
              <br />
              <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal">
                <fieldset>
                  <div class="form-group required account-form-item">
                    <label class="col-sm-2 control-label" for="input-email">{{ entry_email }}</label>
                    <div class="">
                      <input type="text" name="email" value="{{ email }}" id="input-email" class="" />
                    </div>
                  </div>
                </fieldset>
                <input type="hidden" name="form_name" value="forgotten" />
                <div class="buttons clearfix">
                  <div class="pull-left">
                    <a href="{{ back }}" class="btn btn-default">{{ button_back }}</a>
                  </div>
                  <div class="pull-right">
                    <input type="submit" value="{{ button_continue }}" class="btn btn-dark" />
                  </div>
                </div>
              </form>
              {{ content_bottom }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{{ footer }}
