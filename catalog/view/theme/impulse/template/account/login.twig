{{ header }}

<nav class="breadcrumbs" aria-label="breadcrumb">
  <div class="_container">
    <ol class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item">
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        </li>
      {% endfor %}
    </ol>
  </div>
</nav>

<section class="account">
  <div class="_container">
    <div class="account__wrapper">
      <h1 class="account__title h2 section-title">Особистий кабінет</h1>
      {% if success %}
        <div class="alert alert-success alert-dismissible">
          <i class="fa fa-check-circle"></i> {{ success }}
        </div>
      {% endif %}
      {% if error_warning %}
        <div class="alert alert-danger alert-dismissible">
          <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        </div>
      {% endif %}
      <div class="account-main">
        <div class="account-list">
          <div class="row gx-5">
            <div class="col-sm-6">
              <div class="well">
                <h2>{{ text_new_customer }}</h2>
                <p>
                  <strong>{{ text_register }}</strong>
                </p>
                <p class="mt-3">{{ text_register_account }}</p>
                <a href="{{ register }}" class="btn btn-dark mt-3">{{ button_continue }}</a>
              </div>
            </div>
            <div class="col-sm-6 mt-5 mt-sm-0">
              <div class="well">
                <h2>{{ text_returning_customer }}</h2>
                <p>
                  <strong>{{ text_i_am_returning_customer }}</strong>
                </p>
                <form action="{{ action }}" method="post" enctype="multipart/form-data" class="mt-3">
                  <div class="form-group">
                    <label class="control-label" for="input-email">{{ entry_email }}</label>
                    <input type="text" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control mt-1" />
                  </div>
                  <div class="form-group mt-3">
                    <label class="control-label" for="input-password">{{ entry_password }}</label>
                    <input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" id="input-password" class="form-control mt-1" />
                    <a href="{{ forgotten }}">{{ text_forgotten }}</a>
                  </div>
                  <input type="submit" value="{{ button_login }}" class="btn btn-dark mt-3" />
                  <input type="hidden" name="form_name" value="login" />
                  {% if redirect %}
                    <input type="hidden" name="redirect" value="{{ redirect }}" />
                  {% endif %}
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{ footer }}
