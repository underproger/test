{{ header }}

<nav class="breadcrumbs" aria-label="breadcrumb">
  <div class="_container">
    <ol class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item">
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        </li>
      {% endfor %}
    </ol>
  </div>
</nav>

<section id="account-reset" class="">
  <div class="_container">
    <div class="account__wrapper">
      <h1 class="account__title h2 section-title">{{ heading_title }}</h1>
      {% if error_warning %}
        <div class="alert alert-danger alert-dismissible">
          <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        </div>
      {% endif %}
      <div class="account-main">
        <div class="account-list">
          <div id="content" class="{{ class }}">
            {{ content_top }}
            <h1>{{ heading_title }}</h1>
            <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal">
              <fieldset class="account-form__wrapper">
                <legend>{{ text_password }}</legend>
                <br/>
                <div class="form-group account-form-item">
                  <label class="col-sm-2 control-label" for="input-password">{{ entry_password }}</label>
                  <div class="">
                    <input type="password" name="password" value="{{ password }}" id="input-password" class="" />
                    {% if error_password %}
                      <div class="text-danger">{{ error_password }}</div>
                    {% endif %}
                  </div>
                </div>
                <div class="form-group account-form-item">
                  <label class="col-sm-2 control-label" for="input-confirm">{{ entry_confirm }}</label>
                  <div class="">
                    <input type="password" name="confirm" value="{{ confirm }}" id="input-confirm" class="" />
                    {% if error_confirm %}
                      <div class="text-danger">{{ error_confirm }}</div>
                    {% endif %}
                  </div>
                </div>
              </fieldset>
              <input type="hidden" name="form_name" value="reset">
              <div class="buttons clearfix">
                <div class="pull-left">
                  <a href="{{ back }}" class="btn btn-default">{{ button_back }}</a>
                </div>
                <div class="pull-right">
                  <button type="submit" class="btn btn-dark">{{ button_continue }}</button>
                </div>
              </div>
            </form>
            {{ content_bottom }}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{ footer }}
