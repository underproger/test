<div id="custom-payment" class="checkout-form-block">
  <div class="checkout-form__title">Спосіб оплати:</div>
  {% if error_warning %}
    <div class="alert alert-warning">
      <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
    </div>
  {% endif %}
  <div class="checkout-form__wrapper">
    {% if payment_methods %}
      {% for payment_method in payment_methods %}
        <div class="checkout-form-item _checkbox radio">
          {% if payment_method['code'] == code or not code %}
            {% set code = payment_method['code'] %}
            <input type="radio" name="payment_method" value="{{ payment_method['code'] }}" checked="checked" />
          {% else %}
            <input type="radio" name="payment_method" value="{{ payment_method['code'] }}" />
          {% endif %}
          <label>
            {{ payment_method['title'] }}
            {% if payment_method['terms'] %}
              ({{ payment_method['terms'] }})
            {% endif %}
            {% if payment_method['description'] is defined %}
              <br /><small>{{ payment_method['description'] }}</small>
            {% endif %}
          </label>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

  <div class="buttons" id="custom-control" style="display:none;">
    <div class="pull-right" style="width: 100%;">
      {% if text_agree %}
        <input type="checkbox" name="agree" value="1" checked="checked" />&nbsp;
        <label for="input-agree" class="control-label">{{ text_agree }}</label>
        <br />
      {% endif %}
    </div>
    <div class="clearfix"></div>
  </div>
