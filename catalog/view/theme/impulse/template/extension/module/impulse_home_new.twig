<section class="new">
    <div class="_container">
        <div class="new__wrapper">
            <h2 class="new__title h2 section-title">{{heading_title}}</h2>
            <div class="new__main">
                <div class="new-image">
                    <div class="new-image__wrapper">
                        <img src="/image/{{image}}" alt="{{heading_title}}">
                    </div>
                </div>
                <div class="new-info">
                    <div class="new-info__title">{{title}}</div>
                    <div class="new-info__text">{{text}}</div>
                    <a href="{{link}}" class="new-info__link">
                        <span>Детальніше</span>
                        <svg width="16" height="8" viewBox="0 0 16 8" fill="#6C6C6C"
                            xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M11.7633 6.67504L12.5715 7.5L16 4L12.5714 0.5L11.7633 1.32496L13.8124 3.41672L0 3.41672V4.58339L13.8123 4.58339L11.7633 6.67504Z"
                                fill="inherit" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
</section>