{% else %}
  <div class="banner">
    <div class="banner__wrapper">
      <div class="banner-slider">
        <div class="swiper">
          <div class="swiper-wrapper">
            {% for banner in banners %}
              {% if banner.sort_order != 0 %}
                {% if (banner.date_start == '0000-00-00' or current_date >= banner.date_start) and (banner.date_end == '0000-00-00' or current_date <= banner.date_end) %}
                  {% if banner.link %}
                    <a href="{{ banner.link }}" class="swiper-slide banner-slide {{ banner.label or banner.title or banner.text ? '' : 'only-image' }} {{ banner.is_full ? 'video-full' : '' }}">
                      {% if banner.label or banner.title or banner.text %}
                        <div class="banner__info">
                          {% if banner.label %}
                            <div class="banner__label">{{ banner.label }}</div>
                          {% endif %}
                          {% if banner.title %}
                            <div class="banner__title">{{ banner.title }}</div>
                          {% endif %}
                          {% if banner.text %}
                            <div class="banner__text">{{ banner.text }}</div>
                          {% endif %}
                        </div>
                      {% endif %}

                      <div class="banner-image">
                        <div class="banner-image__wrapper">
                          {% if banner.is_video %}
                            <video playsinline muted autoplay loop>
                              <source src="{{ banner.image }}" type="video/mp4" />
                            </video>
                          {% else %}
                            <img src="{{ banner.image }}" alt="{{ banner.title }}" />
                          {% endif %}
                        </div>
                      </div>
                    </a>
                  {% else %}
                    <div class="swiper-slide banner-slide {{ banner.label or banner.title or banner.text ? '' : 'only-image' }}  {{ banner.is_full ? 'video-full' : '' }}">
                      {% if banner.label or banner.title or banner.text %}
                        <div class="banner__info">
                          {% if banner.label %}
                            <div class="banner__label">{{ banner.label }}</div>
                          {% endif %}
                          {% if banner.title %}
                            <div class="banner__title">{{ banner.title }}</div>
                          {% endif %}
                          {% if banner.text %}
                            <div class="banner__text">{{ banner.text }}</div>
                          {% endif %}
                        </div>
                      {% endif %}

                      <div class="banner-image">
                        <div class="banner-image__wrapper">
                          <img src="{{ banner.image }}" alt="{{ banner.title }}" />
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
          <div class="swiper-pagination"></div>
