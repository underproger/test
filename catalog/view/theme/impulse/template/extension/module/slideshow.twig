{% if banner_id == 9 %}
  <section class="popular">
    <div class="_container">
      <div class="popular__wrapper">
        <h2 class="popular__title h2 section-title">{{banner_name}}</h2>

        <div class="popular-slider">
          <div class="swiper">
            <div class="swiper-wrapper">
              {% for banner in banners %}
                {% if banner.sort_order != 0 %}
                  {% if (banner.date_start == '0000-00-00' or current_date >= banner.date_start) and (banner.date_end == '0000-00-00' or current_date <= banner.date_end) %}
                    <div class="swiper-slide popular-slide">
                      <a href="{{ banner.link }}" class="popular-image">
                        <div class="popular-image__wrapper">
                          <img src="{{ banner.image }}" alt="{{ banner.title }}" />
                        </div>
                      </a>
                      <div class="popular-info">
                        <a href="{{ banner.link }}" class="popular-info__title">{{ banner.title }}</a>
                        <a href="{{ banner.link }}" class="popular-info__link">
                          <span>{{ banner.text }}</span>

                          <svg width="16" height="8" viewBox="0 0 16 8" fill="#6C6C6C" xmlns="http://www.w3.org/2000/svg">
                            <path d="M11.7633 6.67504L12.5715 7.5L16 4L12.5714 0.5L11.7633 1.32496L13.8124 3.41672L0 3.41672V4.58339L13.8123 4.58339L11.7633 6.67504Z" fill="inherit" />
