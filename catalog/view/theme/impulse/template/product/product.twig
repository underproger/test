            </svg>
          </button>
          <div class="product-buttons-share">
            <button class="product-buttons-share__button">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="#585858" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.16617 16.4152C8.43817 17.0825 7.47801 17.5002 6.41634 17.5002C4.16467 17.5002 2.33301 15.6685 2.33301 13.4168C2.33301 11.1652 4.16467 9.3335 6.41634 9.3335C7.85017 9.3335 9.10901 10.0802 9.83817 11.2025L16.4695 7.412C16.389 7.09116 16.333 6.76216 16.333 6.41683C16.333 4.16516 18.1647 2.3335 20.4163 2.3335C22.668 2.3335 24.4997 4.16516 24.4997 6.41683C24.4997 8.6685 22.668 10.5002 20.4163 10.5002C19.3547 10.5002 18.3945 10.0825 17.6653 9.41516L10.4892 13.516C10.4833 13.8263 10.4367 14.1238 10.3632 14.412L17.6665 18.5852C18.3945 17.9178 19.3547 17.5002 20.4163 17.5002C22.668 17.5002 24.4997 19.3318 24.4997 21.5835C24.4997 23.8352 22.668 25.6668 20.4163 25.6668C18.1647 25.6668 16.333 23.8352 16.333 21.5835C16.333 21.2382 16.389 20.9092 16.4695 20.5883L9.16617 16.4152Z" fill="inherit" />
              </svg>
            </button>

            <div class="product-buttons-share-list">
              <div class="product-buttons-share-list__wrapper">
                <a href="https://telegram.me/share/url?url={{ href }}" target="_blank">
