        <div class="product__description">{{ description }}</div>

        <div class="product__brand">
          <a href="{{manufacturers}}" class="product__brand-logo">
            <img src="/image/{{manufacturer_object.image}}" alt="{{manufacturer_object.name}}">
          </a>
          <div class="product__brand-box">
            <a href="{{manufacturers}}" class="product__brand-title">{{manufacturer_object.name}}</a>
            <div class="product__brand-descr">{{manufacturer_object.description}}</div>
            <a href="{{manufacturers}}" class="product__brand-more">
                <span>Детальніше</span>
                <svg width="16" height="8" viewBox="0 0 16 8" fill="#6C6C6C" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11.7633 6.67504L12.5715 7.5L16 4L12.5714 0.5L11.7633 1.32496L13.8124 3.41672L0 3.41672V4.58339L13.8123 4.58339L11.7633 6.67504Z" fill="inherit"></path>
                </svg>
            </a>
          </div>
        </div>

        <div class="product__delivery">
         <div class="product__delivery-item">
            <div class="product__delivery-item--title"><a href="{{delivery}}">Доставка по всій Україні</a></div>
          </div>

          <div class="product__delivery-item">
            <div class="product__delivery-item--title">Наявність в магазинах:</div>
            {% for location in locations %}
            {% if ( location.location_id == 1 and manufacturer_object.manufacturer_id != 29 ) or ( location.location_id == 2 and manufacturer_object.manufacturer_id != 35 ) %}
            <div class="product__delivery-item--descr" data-location="{{location.location_id}}" data-brand="{{manufacturer_object.manufacturer_id}}">
              <strong><a href="{{contact}}">{{location.name}}</a></strong> <br/><a href="{{ location.comment }}" target="_blank">{{ location.address }}</a>
            </div>
            {% endif %}
            {% endfor %}
          </div>
        </div>

