{% if products %}
<div class="weekly collectionBanner">
  <div class="_container">
      <h2 class="collectionBanner__title h2 section-title">Поєднується з:</h2>
      <div class="collectionBanner__wrapper">
      <div class="collectionBanner__image">
        <img src="{{ collection_image }}" alt="" />
      </div>
      <div class="collectionBanner__points">
       {% for product in products %}
          <div class="collectionBanner__point" style="top:{{points[loop.index]['top']}}%;left:{{points[loop.index]['left']}}%" data-index="{{loop.index}}"></div>
        {% endfor %}
      </div>
      <div class="collectionBanner__products">
        {% for product in products %}
          <div class="collectionBanner__product" data-index="{{loop.index}}">
            {{ include("impulse/template/product/product_card.twig") }}
          </div>
        {% endfor %}
      </div>
      
      <div class="weekly-slider">
        <div class="swiper">
          <div class="swiper-wrapper">
            {% for product in products %}
              <div class="swiper-slide weekly-slide product-card">
                <a href="{{ product.href }}" class="product-card-image">
                  <div class="product-card-image__wrapper">
                    <img src="{{ product.thumb }}" alt="{{ product.name }}" />
                  </div>
                </a>
                <div class="product-card-info">
                  <a href="{{ product.href }}" class="product-card-info__title">{{ product.name }}</a>
                  <a href="{{ product.main_category_href }}" class="product-card-info__cat">{{ product.categories[1].name }}</a>

                  {% if product.price %}
                    <div class="product-card-info__price">
                      {% if not product.special %}
                        <span class="current">{{ product.price }}</span>
                      {% else %}
                        <span class="old">{{ product.price }}</span>
                        <span class="current">{{ product.special }}</span>
                      {% endif %}
                    </div>

                    <p class="price"></p>
                  {% endif %}
                </div>
                {% if product.label_text %}
                  <div class="product-card-sale">{{product.label_text}}</div>
                {% endif %}
                 <button class="product-card-favorite {{ product.is_favorite ? '_active' }}" data-id="product_id={{ product.product_id }}">
                  <svg width="26" height="26" viewBox="0 0 26 26" fill="#585858" xmlns="http://www.w3.org/2000/svg" onclick="wishlist.add('{{ product.product_id }}');">
