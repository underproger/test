{{ header }}

<nav class="breadcrumbs" aria-label="breadcrumb">
  <div class="_container">
    <ol class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item">
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        </li>
      {% endfor %}
    </ol>
  </div>
</nav>

<section id="product" class="product">
  <div class="_container">
    <div class="product__wrapper">
      <div class="product-slider">
        {% if thumb or images %}
          <div class="swiper product-slider-top">
            <div class="swiper-wrapper">
              {% if thumb %}
                <div class="swiper-slide">
                  <a href="{{ full }}" class="product-slider-top-image" data-fancybox="product"><img src="{{ full }}" alt="" /></a>
                </div>
              {% endif %}
              {% if images %}
                {% for image in images %}
                  <div class="swiper-slide">
                      
                      {% if '.mp4' in image.full %}
                      <a href="{{ image.full }}" class="product-slider-top-image" data-fancybox="product">
                        <video playsinline muted autoplay loop>
                          <source src="{{ image.full }}" type="video/mp4">
                        </video>
                      </a>
                      {% else %}
                      <a href="{{ image.full }}" class="product-slider-top-image" data-fancybox="product">
                        <img src="{{ image.full }}" alt="" />
                      </a>
                      {% endif %}

                  </div>
                {% endfor %}
              {% endif %}
            </div>
            <div class="swiper-pagination"></div>
            <div class="swiper-button swiper-button-prev">
              <svg width="45" height="88" viewBox="0 0 45 88" fill="none" xmlns="http://www.w3.org/2000/svg">
                <mask id="mask0_216_231" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="45" height="88">
                  <rect width="45" height="88" fill="#D9D9D9" />
                </mask>
                <g mask="url(#mask0_216_231)">
                  <path d="M3.8147e-06 88C11.6695 88 22.8611 83.3643 31.1127 75.1127C39.3643 66.8611 44 55.6695 44 44C44 32.3305 39.3643 21.1389 31.1127 12.8873C22.8611 4.6357 11.6695 -1.39158e-07 0 0V44L3.8147e-06 88Z" fill="white" fill-opacity="0.27" />
                  <path d="M11.2373 43.2627C11.2365 43.7223 11.3265 44.1775 11.5022 44.6022C11.6779 45.0268 11.9357 45.4126 12.261 45.7372L21.5255 55L24 52.5255L14.7373 43.2627L24 34L21.5255 31.5255L12.2628 40.7882C11.9372 41.1128 11.679 41.4985 11.503 41.9231C11.327 42.3478 11.2367 42.8031 11.2373 43.2627Z" fill="#1A1A1A" fill-opacity="0.93" />
                </g>
              </svg>
            </div>
            <div class="swiper-button swiper-button-next">
              <svg width="45" height="88" viewBox="0 0 45 88" fill="none" xmlns="http://www.w3.org/2000/svg">
                <mask id="mask0_216_232" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="45" height="88">
                  <rect width="45" height="88" transform="matrix(-1 0 0 1 45 0)" fill="#D9D9D9" />
                </mask>
                <g mask="url(#mask0_216_232)">
                  <path d="M45 88C33.3305 88 22.1389 83.3643 13.8873 75.1127C5.6357 66.8611 1 55.6695 1 44C1 32.3305 5.6357 21.1389 13.8873 12.8873C22.1389 4.6357 33.3305 -1.39158e-07 45 0V44L45 88Z" fill="white" fill-opacity="0.27" />
                  <path d="M33.7627 43.2627C33.7635 43.7223 33.6735 44.1775 33.4978 44.6022C33.3221 45.0268 33.0643 45.4126 32.739 45.7372L23.4745 55L21 52.5255L30.2627 43.2627L21 34L23.4745 31.5255L32.7372 40.7882C33.0628 41.1128 33.321 41.4985 33.497 41.9231C33.673 42.3478 33.7633 42.8031 33.7627 43.2627Z" fill="#1A1A1A" fill-opacity="0.93" />
                </g>
              </svg>
            </div>
          </div>
          <div class="swiper product-slider-thumb">
            <div class="swiper-wrapper">
              {% if full %}
                <div class="swiper-slide">
                  <div class="product-slider-thumb-image">
                    <img src="{{ full }}" alt="" />
                  </div>
                </div>
              {% endif %}
              {% if images %}
                {% for image in images %}
                  <div class="swiper-slide">
                    <div class="product-slider-thumb-image">

                      {% if '.mp4' in image.full %}
                      <video playsinline muted autoplay loop>
                        <source src="{{ image.full }}" type="video/mp4">
                      </video>
                      {% else %}
                       <img src="{{ image.full }}" alt="" />
                      {% endif %}

                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        {% endif %}

        <link href="catalog/view/theme/impulse/stylesheet/product-info.css?v=1.2.0" type="text/css" rel="stylesheet" />
        <div class="product-info" data-product-info>
          <ul class="product-info__list">
            <li>Доставка 1-2 дні по Україні</li>
            <li>Примірка перед оплатою</li>
            <li>Відправлення до 3-х товарів на вибір</li>
          </ul>
          {% if product_info_tabs %}
            <div class="product-info__tabs">
              {% for tab in product_info_tabs %}
                <button type="button" class="product-info__tab" id="product-info-tab-{{ tab.id }}" aria-expanded="false" aria-controls="product-info-panel-{{ tab.id }}">{{ tab.title }}</button>
              {% endfor %}
            </div>
            {% for tab in product_info_tabs %}
              <div class="product-info__panel" id="product-info-panel-{{ tab.id }}" role="region" aria-labelledby="product-info-tab-{{ tab.id }}" hidden>
                <div class="product-info__content">{{ tab.description }}</div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
        <script src="catalog/view/theme/impulse/script/product-info.js?v=1.0.0" type="text/javascript"></script>
      </div>

   
      <div class="product-main">
        <div class="product__title h2 section-title">{{ manufacturer }}</div>
        <h1 class="product__cat">{{ heading_title }}</h1>

        <div class="product__price">
          {% if not special %}
            <span class="current">{{ price }}</span>
          {% else %}
            <span class="old">{{ price }}</span>
            <span class="current">{{ special }}</span>
          {% endif %}
        </div>

        {% if product_set %}
        <div class="product__set-block-title">{{config_product_set_title}}</div>
        {% for product in product_set %}
        <div class="product__set">
            <a href="{{ product.href }}" class="product__set-logo">
              <img src="{{ product.thumb }}" alt="{{ product.manufacturer }}">
            </a>
            <div class="product__set-box">
              <a href="{{ product.href }}" class="product__set-title">{{ product.manufacturer }}</a>
              <div class="product__set-descr">{{ product.name }}</div>
              {% if product.price %}
                <div class="product-card-info__price">
                  {% if not product.special %}
                    <span class="current">{{ product.price }}</span>
                  {% else %}
                    <span class="old">{{ product.price }}</span>
                    <span class="current">{{ product.special }}</span>
                  {% endif %}
                </div>

                <p class="price"></p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
        {% if product_set_has_discount %}
        <div class="product__set-block-text">{{config_product_set_text}}</div>
        {% endif %}
        {% endif %}

        <div class="product-chars">
          {% if not in_stock %}
            <div class="product-chars__item">
              Немає в наявності
            </div>
          {% endif %}

          <div class="product-chars__item">
            <span>Код товару:</span> {{ sku }}
          </div>

          {% if options %}
            {% for option in options %}
              {% if option.type == 'select' %}
                {% for option_value in option.product_option_value %}
                  <div class="product-chars__item">
                    <span>{{ option.name }}:</span> {{ option_value.name }}
                  </div>
                {% endfor %}
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if attribute_groups %}
            {% for attribute_group in attribute_groups %}
                {% for attribute in attribute_group.attribute %}
                  {% if attribute.attribute_id == 14 or attribute.attribute_id == 12 %}
                        <div class="product-chars__item">
                          <span>{{ attribute.name }}:</span> {{ attribute.text }}
                        </div>
                  {% endif %}
                {% endfor %}
            {% endfor %}
          {% endif %}
        </div>


        {% if in_stock %}
          {% if options %}
            {% for option in options %}
              {% if option.type == 'radio' %}
                <div class="product-size" id="input-option{{ option.product_option_id }}">
                  {% for option_value in option.product_option_value %}
                    <div class="product-size__item">
                      <input type="radio" name="option[{{ option.product_option_id }}]" id="size-{{ option_value.product_option_value_id }}" value="{{ option_value.product_option_value_id }}" />
                      <label for="size-{{ option_value.product_option_value_id }}">
                        <span class="product-size__letter">{{ option_value.name }}</span>
                        {% if option_value.name != option_value.size_orig %}
                        <span class="product-size__number">{{ option_value.size_orig }}</span>
                        {% endif %}
                      </label>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endif %}

        <p class="product-size-modal _msize-open">Таблиця розмірів</p>

        {% if in_stock %}
        <div class="product-count d-none">
          <button class="product-count__dec d-none">-</button>
          <input type="hidden" name="quantity" min="{{ minimum }}" max="1" value="{{ minimum }}" size="2" id="input-quantity" />
          <input type="hidden" name="product_id" value="{{ product_id }}" />
          <button class="product-count__inc d-none">+</button>
        </div>
        {% endif %}

        <div class="product-buttons">
          {% if in_stock %}
          <button class="product-buttons__cart" id="button-cart">Додати в кошик</button>
          {% endif %}
          <button class="product-buttons__favorite" onclick="wishlist.add('{{ product_id }}');">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="#585858" xmlns="http://www.w3.org/2000/svg">
