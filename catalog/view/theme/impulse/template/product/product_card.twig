<div class="catalog-item product-card">
  <a href="{{ product.href }}" class="product-card-image">
    <div class="product-card-image__wrapper">
      <img class="main" src="{{ product.thumb }}" alt="" />

      {% if product.second_image %}
      <img class="second" src="{{ product.second_image }}" alt="" />
      {% endif %}

      {% if product.options %}
        <div class="product-card-sizes">
          {% for option in product.options %}
            {% for option_value in option.product_option_value %}
              <span>{{ option_value.name }}</span>
            {% endfor %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </a>
  <div class="product-card-info">
  {# <span style="color:white;">{{product.label_text_1}}</span>
  <span style="color:white;">{{product.sort_order}}</span>
  <span style="color:white;">{{product.sku}}</span> #}
    
    <a href="{{ product.href }}" class="product-card-info__title">{{ product.manufacturer }}</a>
    <div class="product-card-info__cat">{{ product.name }}</div>
    <div class="product-card-info__price">
      {% if not product.special %}
        <span class="current">{{ product.price }}</span>
      {% else %}
        <span class="old">{{ product.price }}</span>
        <span class="current">{{ product.special }}</span>
      {% endif %}
    </div>
  </div>
  {% if product.label_text %}
    <div class="product-card-sale">{{ product.label_text }}</div>
  {% endif %}
  <button class="product-card-favorite {{ product.is_favorite ? '_active' }}" data-id="product_id={{ product.product_id }}">
    <svg width="26" height="26" viewBox="0 0 26 26" fill="#585858" xmlns="http://www.w3.org/2000/svg" onclick="wishlist.add('{{ product.product_id }}');">
