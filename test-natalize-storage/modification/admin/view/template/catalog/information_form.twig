{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-information" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li>
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible">
        <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-information" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active">
              <a href="#tab-general" data-toggle="tab">{{ tab_general }}</a>
            </li>
            <li>
              <a href="#tab-data" data-toggle="tab">{{ tab_data }}</a>
            </li>
            <li>
              <a href="#tab-seo" data-toggle="tab">{{ tab_seo }}</a>
            </li>
            <li>
              <a href="#tab-design" data-toggle="tab">{{ tab_design }}</a>
            </li>
            <li>
              <a href="#tab-brand" data-toggle="tab">Бренд</a>
            </li>
          </ul>
          <div class="tab-content">
            <div class="tab-pane active" id="tab-general">
              <ul class="nav nav-tabs" id="language">
                {% for language in languages %}
                  <li>
                    <a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a>
                  </li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% set image_row = 0 %}
                {% for language in languages %}
                  <div class="tab-pane" id="language{{ language.language_id }}">
                    <div class="form-group required">
                      <label class="col-sm-2 control-label" for="input-title{{ language.language_id }}">{{ entry_title }}</label>
                      <div class="col-sm-10">
                        <input type="text" name="information_description[{{ language.language_id }}][title]" value="{{ information_description[language.language_id] ? information_description[language.language_id].title }}" placeholder="{{ entry_title }}" id="input-title{{ language.language_id }}" class="form-control" />
                        {% if error_title[language.language_id] %}
                          <div class="text-danger">{{ error_title[language.language_id] }}</div>
                        {% endif %}
                      </div>
                    </div>
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-meta-h1{{ language.language_id }}">{{ entry_meta_h1 }}</label>
                      <div class="col-sm-10">
                        <input type="text" name="information_description[{{ language.language_id }}][meta_h1]" value="{{ information_description[language.language_id] ? information_description[language.language_id].meta_h1 }}" placeholder="{{ entry_meta_h1 }}" id="input-meta-h1{{ language.language_id }}" class="form-control" />
                      </div>
                    </div>

        {{seo_package_snippet_metas[language.language_id]}}
      
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-meta-title{{ language.language_id }}">{{ entry_meta_title }}</label>
                      <div class="col-sm-10">
                                              <div class="input-group">
                        <input type="text" name="information_description[{{ language.language_id }}][meta_title]" value="{{ information_description[language.language_id] ? information_description[language.language_id].meta_title }}" placeholder="{{ entry_meta_title }}" id="input-meta-title{{ language.language_id }}" class="form-control" />
                        <span class="input-group-addon btn btn-primary" data-toggle="tooltip" title="Generate value" onClick="seoPackageGen('meta_title', '{{language.language_id}}')"><i class="fa fa-bolt"></i></span>
                      </div>
                      </div>
                    </div>
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-meta-description{{ language.language_id }}">{{ entry_meta_description }}</label>
                      <div class="col-sm-10">
                                              <div class="input-group">
                        <textarea name="information_description[{{ language.language_id }}][meta_description]" rows="5" placeholder="{{ entry_meta_description }}" id="input-meta-description{{ language.language_id }}" class="form-control">{{ information_description[language.language_id] ? information_description[language.language_id].meta_description }}</textarea>
                        <span class="input-group-addon btn btn-primary" data-toggle="tooltip" title="Generate value" onClick="seoPackageGen('meta_description', '{{language.language_id}}')"><i class="fa fa-bolt"></i></span>
                      </div>
                      </div>
                    </div>
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-meta-keyword{{ language.language_id }}">{{ entry_meta_keyword }}</label>
                      <div class="col-sm-10">
                                              <div class="input-group">
                        <textarea name="information_description[{{ language.language_id }}][meta_keyword]" rows="5" placeholder="{{ entry_meta_keyword }}" id="input-meta-keyword{{ language.language_id }}" class="form-control">{{ information_description[language.language_id] ? information_description[language.language_id].meta_keyword }}</textarea>
                        <span class="input-group-addon btn btn-primary" data-toggle="tooltip" title="Generate value" onClick="seoPackageGen('meta_keyword', '{{language.language_id}}')"><i class="fa fa-bolt"></i></span>
                      </div>
                      </div>
                    </div>
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-image{{ language.language_id }}">Зображення</label>
                      <div class="col-sm-10">
                        <a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="/image/{{ information_description[language.language_id].image }}" alt="" title="" data-placeholder="{{ placeholder }}" style="width: 300px; height: auto;" /></a>
                        <input type="hidden" name="information_description[{{ language.language_id }}][image]" value="{{ information_description[language.language_id].image }}" id="input-image{{ language.language_id }}" />
                      </div>
                    </div>
                    <div class="form-group required">
                      <label class="col-sm-2 control-label" for="input-description{{ language.language_id }}">{{ entry_description }}</label>
                      <div class="col-sm-10">
                        <textarea name="information_description[{{ language.language_id }}][description]" placeholder="{{ entry_description }}" id="input-description{{ language.language_id }}" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ information_description[language.language_id] ? information_description[language.language_id].description }}</textarea>
                        {% if error_description[language.language_id] %}
                          <div class="text-danger">{{ error_description[language.language_id] }}</div>
                        {% endif %}
                      </div>
                    </div>

                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-description2{{ language.language_id }}">{{ entry_description }} 2</label>
                      <div class="col-sm-10">
                        <textarea name="information_description[{{ language.language_id }}][description2]" placeholder="{{ entry_description }} 2" id="input-description2{{ language.language_id }}" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ information_description[language.language_id] ? information_description[language.language_id].description2 }}</textarea>
                      </div>
                    </div>

                    <div class="form-group">
                      <table id="images{{ language.language_id }}" class="table table-striped table-bordered table-hover">
                        <thead>
                          <tr>
                            <td class="text-left">Заголовок</td>
                            <td class="text-left">Посилання</td>
                            <td class="text-center">Зображення</td>
                            <td></td>
                          </tr>
                        </thead>
                        <tbody>
                          {% if information_description[language.language_id].sales %}
                            {% for sale in information_description[language.language_id].sales %}
                              <tr id="image-row{{ image_row }}">
                                <td class="text-left">
                                  <input type="text" name="information_description[{{ language.language_id }}][sales][{{ image_row }}][title]" value="{{ sale.title }}" placeholder="{{ entry_title }}" class="form-control" />
                                </td>
                                <td class="text-left" style="width: 40%;">
                                  <input type="text" name="information_description[{{ language.language_id }}][sales][{{ image_row }}][link]" value="{{ sale.link }}" placeholder="{{ entry_link }}" class="form-control" />
                                </td>
                                <td class="text-center">
                                  <a href="" id="thumb-image{{ image_row }}" data-toggle="image" class="img-thumbnail"><img src="/image/{{ sale.image }}" alt="" title="" width="300px" data-placeholder="{{ placeholder }}" /></a>
                                  <input type="hidden" name="information_description[{{ language.language_id }}][sales][{{ image_row }}][image]" value="{{ sale.image }}" id="input-image-sales{{ image_row }}" />
                                </td>
                                <td class="text-left">
                                  <button type="button" onclick="$('#image-row{{ image_row }}, .tooltip').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
                                </td>
                              </tr>
                              {% set image_row = image_row + 1 %}
                            {% endfor %}
                          {% endif %}
                        </tbody>
                        <tfoot>
                          <tr>
                            <td colspan="3"></td>
                            <td class="text-left">
                              <button type="button" onclick="addImage('{{ language.language_id }}');" data-toggle="tooltip" title="{{ button_banner_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button>
                            </td>
                          </tr>
                        </tfoot>
                      </table>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
            <div class="tab-pane" id="tab-data">
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_store }}</label>
                <div class="col-sm-10">
                  <div class="well well-sm" style="height: 150px; overflow: auto;">
                    {% for store in stores %}
                      <div class="checkbox">
                        <label>
                          {% if store.store_id in information_store %}
                            <input type="checkbox" name="information_store[]" value="{{ store.store_id }}" checked="checked" />
                            {{ store.name }}
                          {% else %}
                            <input type="checkbox" name="information_store[]" value="{{ store.store_id }}" />
                            {{ store.name }}
                          {% endif %}
                        </label>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-bottom"><span data-toggle="tooltip" title="{{ help_bottom }}">{{ entry_bottom }}</span></label>
                <div class="col-sm-10">
                  <div class="checkbox">
                    <label>
                      {% if bottom %}
                        <input type="checkbox" name="bottom" value="1" checked="checked" id="input-bottom" />
                      {% else %}
                        <input type="checkbox" name="bottom" value="1" id="input-bottom" />
                      {% endif %}&nbsp;
                    </label>
                  </div>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <select name="status" id="input-status" class="form-control">
                    {% if status %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                    {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>

              {{seo_package_snippet_robots}}
      
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
                <div class="col-sm-10">
                  <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
                </div>
              </div>
            </div>
            
      <div class="tab-pane" id="tab-seo">
        {{seo_package_tab}}
      </div>
      <div class="tab-pane" id="tab-seo-disabled">
              <div class="alert alert-info">
                <i class="fa fa-info-circle"></i> {{ text_keyword }}
              </div>
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <thead>
                    <tr>
                      <td class="text-left">{{ entry_store }}</td>
                      <td class="text-left">{{ entry_keyword }}</td>
                    </tr>
                  </thead>
                  <tbody>
                    {% for store in stores %}
                      <tr>
                        <td class="text-left">{{ store.name }}</td>
                        <td class="text-left">
                          {% for language in languages %}
                            <div class="input-group">
                              <span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
                              <input type="text" name="information_seo_url_disabled[{{ store.store_id }}][{{ language.language_id }}]" value="{% if information_seo_url[store.store_id][language.language_id] %}{{ information_seo_url[store.store_id][language.language_id] }}{% endif %}" placeholder="{{ entry_keyword }}" class="form-control" />
                            </div>
                            {% if error_keyword[store.store_id][language.language_id] %}
                              <div class="text-danger">{{ error_keyword[store.store_id][language.language_id] }}</div>
                            {% endif %}
                          {% endfor %}
                        </td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-noindex">{{ entry_noindex }}</label>
                <div class="col-sm-10">
                  <select name="noindex" id="input-noindex" class="form-control">
                    {% if noindex %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                    {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
            </div>
            <div class="tab-pane" id="tab-design">
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <thead>
                    <tr>
                      <td class="text-left">{{ entry_store }}</td>
                      <td class="text-left">{{ entry_layout }}</td>
                    </tr>
                  </thead>
                  <tbody>
                    {% for store in stores %}
                      <tr>
                        <td class="text-left">{{ store.name }}</td>
                        <td class="text-left">
                          <select name="information_layout[{{ store.store_id }}]" class="form-control">
                            <option value=""></option>
                            {% for layout in layouts %}
                              {% if information_layout[store.store_id] and information_layout[store.store_id] == layout.layout_id %}
                                <option value="{{ layout.layout_id }}" selected="selected">{{ layout.name }}</option>
                              {% else %}
                                <option value="{{ layout.layout_id }}">{{ layout.name }}</option>
                              {% endif %}
                            {% endfor %}
                          </select>
                        </td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>

             <div class="tab-pane" id="tab-brand">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-is_brand"><span>Сторінка бренду</span></label>
                <div class="col-sm-10">
                  <div class="checkbox">
                    <label>
                      {% if is_brand %}
                        <input type="checkbox" name="is_brand" value="1" checked="checked" id="input-is_brand" />
                      {% else %}
                        <input type="checkbox" name="is_brand" value="1" id="input-is_brand" />
                      {% endif %}&nbsp;
                    </label>
                  </div>
                </div>
              </div>

              <ul class="nav nav-tabs" id="brand-language">
                {% for language in languages %}
                  <li>
                    <a href="#brand-language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a>
                  </li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% set brand_image_row = 0 %}
                {% for language in languages %}
                  <div class="tab-pane" id="brand-language{{ language.language_id }}">
                    
                    {# block 1 #}
                    <label class="col-12 control-label">Блок 1</label>

                    {# block 1 title #}
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-brand-block_1_title{{ language.language_id }}">Назва бренду</label>
                      <div class="col-sm-10">
                        <input type="text" name="information_brand[{{ language.language_id }}][block_1_title]" value="{{ information_brand[language.language_id] ? information_brand[language.language_id].block_1_title }}" placeholder="Назва бренду" id="input-brand-block_1_title{{ language.language_id }}" class="form-control" />
                      </div>
                    </div>
                   
                    {# block 1 image #}
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-brand-block_1_image{{ language.language_id }}">Зображення</label>
                      <div class="col-sm-10">
                        <a href="" id="block_1_image" data-toggle="image" class="img-thumbnail"><img src="/image/{{ information_brand[language.language_id].block_1_image }}" alt="" title="" data-placeholder="{{ placeholder }}" style="width: 300px; height: auto;" /></a>
                        <input type="hidden" name="information_brand[{{ language.language_id }}][block_1_image]" value="{{ information_brand[language.language_id].block_1_image }}" id="input-block_1_image{{ language.language_id }}" />
                      </div>
                    </div>

                    {# block 1 text color #}
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-brand-block_1_text-color{{ language.language_id }}">Колір тексту</label>
                      <div class="col-sm-10">
                        <input type="text" name="information_brand[{{ language.language_id }}][block_1_text_color]" value="{{ information_brand[language.language_id] ? information_brand[language.language_id].block_1_text_color }}" placeholder="Колір тексту" id="input-brand-block_1_text-color{{ language.language_id }}" class="form-control" />
                      </div>
                    </div>

                    {# block 1 text #}
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-brand-block_1_text{{ language.language_id }}">Текст</label>
                      <div class="col-sm-10">
                        <textarea name="information_brand[{{ language.language_id }}][block_1_text]" placeholder="Опис" id="input-brand-block_1_text{{ language.language_id }}" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ information_brand[language.language_id] ? information_brand[language.language_id].block_1_text }}</textarea>
                      </div>
                    </div>

                    {# block 2 #}
                    <label class="col-12 control-label">Блок 2</label>

                    {# block 2 text 1 #}
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-brand-block_2_text_1{{ language.language_id }}">Текст 1</label>
                      <div class="col-sm-10">
                        <textarea name="information_brand[{{ language.language_id }}][block_2_text_1]" placeholder="{{ entry_description }} 2" id="input-brand-block_2_text_1{{ language.language_id }}" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ information_brand[language.language_id] ? information_brand[language.language_id].block_2_text_1 }}</textarea>
                      </div>
                    </div>

                    {# block 2 text 1 #}
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-brand-block_2_text_2{{ language.language_id }}">Текст 2</label>
                      <div class="col-sm-10">
                        <textarea name="information_brand[{{ language.language_id }}][block_2_text_2]" placeholder="{{ entry_description }} 2" id="input-brand-block_2_text_2{{ language.language_id }}" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ information_brand[language.language_id] ? information_brand[language.language_id].block_2_text_2 }}</textarea>
                      </div>
                    </div>

                    {# block 2 image 1 #}
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-brand-block_2_image_1{{ language.language_id }}">Зображення 1</label>
                      <div class="col-sm-10">
                        <a href="" id="block_2_image_1" data-toggle="image" class="img-thumbnail"><img src="/image/{{ information_brand[language.language_id].block_2_image_1 }}" alt="" title="" data-placeholder="{{ placeholder }}" style="width: 300px; height: auto;" /></a>
                        <input type="hidden" name="information_brand[{{ language.language_id }}][block_2_image_1]" value="{{ information_brand[language.language_id].block_2_image_1 }}" id="input-block_2_image_1{{ language.language_id }}" />
                      </div>
                    </div>

                    {# block 2 image 2 #}
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-brand-block_2_image_2{{ language.language_id }}">Зображення 2</label>
                      <div class="col-sm-10">
                        <a href="" id="block_2_image_2" data-toggle="image" class="img-thumbnail"><img src="/image/{{ information_brand[language.language_id].block_2_image_2 }}" alt="" title="" data-placeholder="{{ placeholder }}" style="width: 300px; height: auto;" /></a>
                        <input type="hidden" name="information_brand[{{ language.language_id }}][block_2_image_2]" value="{{ information_brand[language.language_id].block_2_image_2 }}" id="input-block_2_image_2{{ language.language_id }}" />
                      </div>
                    </div>

                    {# block 2 text 2 #}
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-brand-block_2_text_3{{ language.language_id }}">Текст 3</label>
                      <div class="col-sm-10">
                        <textarea name="information_brand[{{ language.language_id }}][block_2_text_3]" placeholder="{{ entry_description }} 2" id="input-brand-block_2_text_3{{ language.language_id }}" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ information_brand[language.language_id] ? information_brand[language.language_id].block_2_text_3 }}</textarea>
                      </div>
                    </div>

                    {# block 2 quote #}
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-brand-quote{{ language.language_id }}">Цитата</label>
                      <div class="col-sm-10">
                        <textarea name="information_brand[{{ language.language_id }}][quote]" placeholder="{{ entry_description }} 2" id="input-brand-quote{{ language.language_id }}" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ information_brand[language.language_id] ? information_brand[language.language_id].quote }}</textarea>
                      </div>
                    </div>

                    {# block 2 quote author #}
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-brand-quote_author{{ language.language_id }}">Автор цитати</label>
                      <div class="col-sm-10">
                        <input type="text" name="information_brand[{{ language.language_id }}][quote_author]" value="{{ information_brand[language.language_id] ? information_brand[language.language_id].quote_author }}" placeholder="Автор цитати" id="input-brand-quote_author{{ language.language_id }}" class="form-control" />
                      </div>
                    </div>


                   {# block 3 #}
                    <label class="col-12 control-label">Блок 3</label>

                    {# block 3 text 1 #}
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="input-brand-block_3_text_1{{ language.language_id }}">Текст 1</label>
                      <div class="col-sm-10">
                        <textarea name="information_brand[{{ language.language_id }}][block_3_text_1]" placeholder="{{ entry_description }} 2" id="input-brand-block_3_text_1{{ language.language_id }}" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ information_brand[language.language_id] ? information_brand[language.language_id].block_3_text_1 }}</textarea>
                      </div>
                    </div>

                
                    {# block 3 images #}
                    <div class="form-group">
                      <table id="brand-images-table{{ language.language_id }}" class="table table-striped table-bordered table-hover">
                        <thead>
                          <tr>
                            <td class="text-center">Зображення</td>
                            <td></td>
                          </tr>
                        </thead>
                        <tbody>
                          {% if information_brand[language.language_id].images %}
                            {% for image in information_brand[language.language_id].images %}
                              <tr id="brand-images-row{{ brand_image_row }}">
                                <td class="text-center">
                                  <a href="" id="brand-images{{ brand_image_row }}" data-toggle="image" class="img-thumbnail"><img src="/image/{{ image.image }}" alt="" title="" width="300px" data-placeholder="{{ placeholder }}" /></a>
                                  <input type="hidden" name="information_brand[{{ language.language_id }}][images][{{ brand_image_row }}][image]" value="{{ image.image }}" id="input-brand-images{{ brand_image_row }}" />
                                </td>
                                <td class="text-left">
                                  <button type="button" onclick="$('#brand-images-row{{ brand_image_row }}, .tooltip').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
                                </td>
                              </tr>
                              {% set brand_image_row = brand_image_row + 1 %}
                            {% endfor %}
                          {% endif %}
                        </tbody>
                        <tfoot>
                          <tr>
                            <td colspan="1"></td>
                            <td class="text-left">
                              <button type="button" onclick="addBrandImage('{{ language.language_id }}');" data-toggle="tooltip" title="{{ button_banner_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button>
