  <script type="text/javascript"><!--
var image_row = {{ image_row }};

function addImage(language_id) {
	html  = '<tr id="image-row' + image_row + '">';
    html += '  <td class="text-left"><input type="text" name="information_description[' + language_id + '][sales][' + image_row + '][title]" value="" placeholder="Заголовок" class="form-control" /></td>';	
	html += '  <td class="text-left" style="width: 40%;"><input type="text" name="information_description[' + language_id + '][sales][' + image_row + '][link]" value="" placeholder="Посилання" class="form-control" /></td>';	
	html += '  <td class="text-center"><a href="" id="thumb-image' + image_row + '" data-toggle="image" class="img-thumbnail"><img src="/image/cache/no_image-100x100.png" alt="" title="" data-placeholder="{{ placeholder }}" /></a><input type="hidden" name="information_description[' + language_id + '][sales][' + image_row + '][image]" value="" id="input-image-sales' + image_row + '" /></td>';
	html += '  <td class="text-left"><button type="button" onclick="$(\'#image-row' + image_row  + ', .tooltip\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
	html += '</tr>';
	
	$('#images' + language_id + ' tbody').append(html);
	
	image_row++;
}
//--></script>

  <script type="text/javascript"><!--
$('#language a:first').tab('show');
//--></script>

  <script type="text/javascript"><!--
$('#brand-language a:first').tab('show');
//--></script>

<script type="text/javascript"><!--
  var brand_image_row = {{ brand_image_row }};

  function addBrandImage(language_id) {
    html  = '<tr id="brand-images-row' + brand_image_row + '">';
    html += '  <td class="text-center"><a href="" id="brand-images' + brand_image_row + '" data-toggle="image" class="img-thumbnail"><img src="/image/cache/no_image-100x100.png" alt="" title="" data-placeholder="{{ placeholder }}" /></a><input type="hidden" name="information_brand[' + language_id + '][images][' + brand_image_row + '][image]" value="" id="input-brand-images' + brand_image_row + '" /></td>';
    html += '  <td class="text-left"><button type="button" onclick="$(\'#brand-images-row' + brand_image_row  + ', .tooltip\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
    html += '</tr>';
    
    $('#brand-images-table' + language_id + ' tbody').append(html);
    
    brand_image_row++;
  }
//--></script>
